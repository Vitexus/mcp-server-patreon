#!/usr/bin/make -f

export PYBUILD_NAME=patreon_mcp_server

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install --destdir=debian/mcp-server-patreon

override_dh_auto_test:
	# Not run at build time: python3-fastmcp is a runtime dependency, not
	# guaranteed present in the build chroot. The smoke test runs
	# post-install via debian/tests (autopkgtest).
	appstreamcli validate --no-net debian/mcp-server-patreon.metainfo.xml

override_dh_install:
	dh_install
	install -D -m644 debian/mcp-server-patreon.metainfo.xml \
		debian/mcp-server-patreon/usr/share/metainfo/io.github.vitexsoftware.mcp-server-patreon.metainfo.xml
